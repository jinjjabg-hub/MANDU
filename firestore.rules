rules_version = '2';
// MANDU 전용 Firebase 프로젝트(mandutok) 규칙.
// 콘솔에서 직접 고치지 말고 이 파일을 고친 뒤 전체를 복사해 게시할 것.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필(이메일·알림 토큰·요금제·사용량 포함) — 본인만 읽는다.
    // 다른 사람에게 필요한 이름·사진·만두ID·매장 설정은 public_profiles 에서 읽는다(아래).
    // 전체 가입자 목록 조회(list)는 금지 (예외 없음). 카드북 연결은 cardbook_index(이메일 → uid·만두ID만)를 쓴다(아래).
    // 탐색 탭은 users가 아니라 discover_profiles(공개용 정보만)를 읽는다. 쓰기는 본인만. 단 번역 사용량(usage)·요금제(plan)·결제 요약(billing)은 서버(Admin SDK, 규칙 우회)만
    // 기록한다 — 결제 성공 시에만 서버가 plan/billing을 쓰므로 클라이언트는 만들거나 바꿀 수 없다.
    // 추천 보너스(bonusChars·bonusExpiresAt·bonusUsed)와 충전 글자(packChars·packExpiresAt·packUsed)도 서버만 기록한다. 추천 기록(referrals)은 맨 아래 기본 차단 규칙으로 서버 전용.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;   // 예전엔 cardbookConsent 회원 목록 조회를 허용했지만, 문서 전체(이메일·알림 토큰·요금제)가 노출돼 막았다
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['usage', 'plan', 'billing', 'bonusChars', 'bonusExpiresAt', 'bonusUsed', 'packChars', 'packExpiresAt', 'packUsed']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usage', 'plan', 'billing', 'bonusChars', 'bonusExpiresAt', 'bonusUsed', 'packChars', 'packExpiresAt', 'packUsed']);
      allow delete: if request.auth != null && request.auth.uid == uid;   // 회원 탈퇴 시 본인 프로필 삭제

      // 번역 사용 내역 — 서버(Admin SDK)만 기록하고, 본인만 읽는다. (원문은 저장되지 않음)
      match /usage_log/{logId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 내 사전 — 본인만 읽고 쓴다.
      match /mydict/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 번역 결과 백업 — 한 번 번역한 메시지를 다른 기기·앱 재설치 후에도 같은 번역으로 보여준다. 본인만 읽고 쓴다.
      match /trcache/{key} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 매장(손님) 방 표시 — storeUid·customerUid·isGuestRoom 은 방 ID와 맞아야 한다.
    //   손님 방 ID = guest_{손님uid}_{주인uid} (익명 손님) / store_{손님uid}_{주인uid} (가입한 손님)
    //   → 남의 방을 '내 가게 손님방'으로 꾸며 주인 번역 한도를 쓰게 만드는 위조를 막는다.
    function storeFieldsOk(roomId, d) {
      return !(d.get('storeUid', null) != null || d.get('customerUid', null) != null || d.get('isGuestRoom', false) == true)
        || (d.storeUid is string && d.customerUid is string
            && d.storeUid in d.members && d.customerUid in d.members
            && ((roomId == 'store_' + d.customerUid + '_' + d.storeUid && d.get('isGuestRoom', false) == false)
                || roomId == 'guest_' + d.customerUid + '_' + d.storeUid));
    }

    // 손님(익명) 방을 받는 매장인지 — 주인이 매장 설정을 켠 경우만(공개 명함의 store.active, 또는 예전 앱이 저장한
    // 인사말·부재 응답·빠른 답장·직원 중 하나라도 있는 경우). 손님방은 주인의 번역 한도를 쓰므로,
    // 아무 회원이나 '사장님'으로 지정해 그 사람 한도(BUSINESS면 초과 요금)를 쓰게 하는 것을 막는다. 서버 _guest_room_host 도 같은 조건.
    function storeOpen(uid) {
      let p = /databases/$(database)/documents/public_profiles/$(uid);
      return exists(p) && storeActive(get(p).data.get('store', null));
    }
    function storeActive(st) {
      return st is map
        && (st.get('active', false) == true || st.get('greetOn', false) == true || st.get('awayOn', false) == true
            || st.get('welcomeOn', false) == true
            || st.get('quick', []).size() > 0 || st.get('staff', []).size() > 0);
    }

    // 멤버별 칸(memberNames·memberPhotos): 본인 칸, 이번에 새로 들어온 멤버 칸, 이미 나간 사람 칸(정리)만 바꿀 수 있다.
    // → 남의 이름·사진을 바꿔 사칭하는 것을 막는다. 값은 짧은 글자만.
    function perMemberMapOk(nm, om, newMembers, oldMembers, me) {
      return nm is map
        && nm.diff(om).affectedKeys()
             .difference([me].toSet())
             .difference(newMembers.toSet().difference(oldMembers.toSet()))
             .intersection(newMembers.toSet()).size() == 0
        && (!(me in nm) || (nm[me] is string && nm[me].size() <= 500));
    }
    // 안 읽은 수:
    //  · msgSeq  : 방의 메시지 번호. 메시지를 보낼 때마다 정확히 1씩만 늘릴 수 있다.
    //  · readSeq : {uid: 마지막으로 읽은 msgSeq} — 본인 칸만. 안 읽은 수 = msgSeq − readSeq[나] (앱·서버 배지 모두 같은 식).
    //  · unreadCount(예전 방식): 내 칸은 자유(읽음 → 0), 남의 칸은 그대로이거나 정확히 1 증가만.
    //    규칙에는 반복문이 없고 계산량 한도(1000)가 있어, 멤버 10명 이하 방에서만 남의 칸을 늘릴 수 있다(예전 앱 호환).
    function unreadIncOk(n, o, u, me) {
      return u == me || n.get(u, 0) == o.get(u, 0) || n.get(u, 0) == o.get(u, 0) + 1;
    }
    function unreadOk(n, o, m, me) {
      return n is map
        && n.diff(o).affectedKeys().difference([me].toSet()).size() == 0
        || (m.size() <= 10
            && n.diff(o).affectedKeys().difference([me].toSet()).difference(m.toSet()).size() == 0
            && unreadSmall(n, o, m.concat([me, me, me, me, me, me, me, me, me, me]), me));
    }
    // 멤버 목록 끝에 내 uid를 10개 붙여(검사 안 함) 범위를 넘지 않게 한다.
    function unreadSmall(n, o, pm, me) {
      return unreadIncOk(n, o, pm[0], me) && unreadIncOk(n, o, pm[1], me) && unreadIncOk(n, o, pm[2], me) && unreadIncOk(n, o, pm[3], me) && unreadIncOk(n, o, pm[4], me) && unreadIncOk(n, o, pm[5], me) && unreadIncOk(n, o, pm[6], me) && unreadIncOk(n, o, pm[7], me) && unreadIncOk(n, o, pm[8], me) && unreadIncOk(n, o, pm[9], me);
    }

    // 채팅방 — 멤버만 읽고 쓸 수 있다.
    // optIn: {uid: true} — 그 사람이 이 방의 알림을 받겠다고 한 표시(방을 만들거나, 메시지를 보내거나, 초대 링크로 들어옴).
    //   본인 칸만 쓸 수 있다. 서버 /api/notify 는 optIn·친구·답장 기록이 없는 '처음 연락'에는 푸시를 보내지 않는다(스팸 방 방지).
    match /rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // 만들 때: 내가 멤버에 포함, 최대 50명, 매장 방이면 내가 그 손님 본인이어야 하고, 손님(익명)방이면 주인이 매장 설정을 켰어야 한다.
      // 이름·사진 칸은 멤버 것만, 수신 동의·안 읽은 수는 내 칸만, 방 이름은 그룹 방만.
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 50
        && storeFieldsOk(roomId, request.resource.data)
        && request.resource.data.get('customerUid', request.auth.uid) == request.auth.uid
        && (request.resource.data.get('isGuestRoom', false) != true || storeOpen(request.resource.data.storeUid))
        && request.resource.data.get('type', 'direct') in ['direct', 'group']
        && (!('name' in request.resource.data)
            || (request.resource.data.get('type', '') == 'group' && request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && perMemberMapOk(request.resource.data.get('memberNames', {}), {}, request.resource.data.members, [], request.auth.uid)
        && request.resource.data.get('memberNames', {}).keys().hasOnly(request.resource.data.members)
        && perMemberMapOk(request.resource.data.get('memberPhotos', {}), {}, request.resource.data.members, [], request.auth.uid)
        && request.resource.data.get('memberPhotos', {}).keys().hasOnly(request.resource.data.members)
        && request.resource.data.get('optIn', {}).keys().hasOnly([request.auth.uid])
        && request.resource.data.get('readBy', {}).keys().hasOnly([request.auth.uid])
        && request.resource.data.get('readSeq', {}).keys().hasOnly([request.auth.uid])
        && request.resource.data.get('msgSeq', 0) in [0, 1]
        && request.resource.data.get('unreadCount', {}) is map
        && request.resource.data.get('unreadCount', {}).keys().hasOnly(request.resource.data.members)
        && request.resource.data.get('unreadCount', {}).values().hasOnly([0, 1])
        && request.resource.data.get('lastMessageUid', request.auth.uid) == request.auth.uid;
      // 고칠 때: 멤버만. 다른 멤버를 내보낼 수 없고(추가·본인 나가기만), 매장 방 정보는 바꿀 수 없으며,
      // 읽음 표시(readBy)·수신 동의(optIn)는 본인 것만, 남의 이름·사진은 바꿀 수 없고(새로 들어온 멤버 칸만 추가),
      // 남의 안 읽은 수는 1씩 늘리기만, 방 이름은 그룹 방만 바꿀 수 있다.
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50
        && (request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
            // 매장 방: 손님·주인은 직원 구성을 맞출 수 있다(직원 변경·1:1로 되돌리기). 손님과 주인은 항상 남아 있어야 한다.
            || (resource.data.get('storeUid', null) != null
                && request.auth.uid in [resource.data.storeUid, resource.data.get('customerUid', '')]
                && request.resource.data.members.hasAll([resource.data.storeUid, resource.data.get('customerUid', '')])))
        && storeFieldsOk(roomId, request.resource.data)
        && (!('storeUid' in resource.data) || request.resource.data.get('storeUid', null) == resource.data.storeUid)
        && (!('customerUid' in resource.data) || request.resource.data.get('customerUid', null) == resource.data.customerUid)
        && (request.resource.data.get('isGuestRoom', false) == resource.data.get('isGuestRoom', false)
            || (!('isGuestRoom' in resource.data) && request.resource.data.isGuestRoom == true && storeOpen(request.resource.data.storeUid)))
        // 방 종류: 그대로 / 1:1 → 그룹(멤버 추가) / 매장 방의 손님·주인은 그룹 → 1:1 되돌리기
        && (request.resource.data.get('type', 'direct') == resource.data.get('type', 'direct')
            || request.resource.data.get('type', '') == 'group'
            || (resource.data.get('storeUid', null) != null && request.resource.data.get('type', '') == 'direct'
                && request.auth.uid in [resource.data.storeUid, resource.data.get('customerUid', '')]))
        // 방 이름: 그대로 / 지우기 / 그룹 방일 때만 바꾸기
        && (request.resource.data.get('name', null) == resource.data.get('name', null)
            || !('name' in request.resource.data)
            || (request.resource.data.get('type', '') == 'group' && request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && perMemberMapOk(request.resource.data.get('memberNames', {}), resource.data.get('memberNames', {}),
             request.resource.data.members, resource.data.members, request.auth.uid)
        && perMemberMapOk(request.resource.data.get('memberPhotos', {}), resource.data.get('memberPhotos', {}),
             request.resource.data.members, resource.data.members, request.auth.uid)
        && request.resource.data.get('optIn', {}).diff(resource.data.get('optIn', {})).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.get('msgSeq', 0) == resource.data.get('msgSeq', 0)
            || request.resource.data.get('msgSeq', 0) == resource.data.get('msgSeq', 0) + 1)
        && request.resource.data.get('readSeq', {}).diff(resource.data.get('readSeq', {})).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.get('unreadCount', {}) == resource.data.get('unreadCount', {})
            || unreadOk(request.resource.data.get('unreadCount', {}), resource.data.get('unreadCount', {}), request.resource.data.members, request.auth.uid))
        && (request.resource.data.get('lastMessageUid', null) == resource.data.get('lastMessageUid', null)
            || request.resource.data.get('lastMessageUid', null) == request.auth.uid)
        && (!('readBy' in request.resource.data)
            || request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;

      // 메시지 — 그 방 멤버만. 세 종류만 허용:
      //  1) 일반 메시지: 보낸 사람(uid)이 본인. 이름(displayName)은 저장하지 않는다(예전 앱 호환: 넣더라도 방의 내 이름과 같아야 함).
      //     화면은 메시지의 이름 대신 방 멤버 정보·공개 명함의 이름을 쓴다.
      //  2) 시스템 안내(입장·멤버 추가·방 이름 변경): type 'system' + 정해진 종류(kind)와 멤버 uid 목록(+ 바뀐 방 이름)만. 문구는 앱이 만들어 표시한다
      //     (자유 문구를 허용하면 '[MANDU 공지] 결제 정보 재등록' 같은 가짜 공지를 띄울 수 있다).
      //  3) 매장 자동 메시지(인사말·부재 응답): 손님 기기가 주인 이름으로 올리므로,
      //     글 내용이 주인이 공개 프로필에 저장한 인사말/부재 응답과 정확히 같아야 한다(가짜 공지 방지).
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow create: if request.auth != null
          && msgCreateOk(get(/databases/$(database)/documents/rooms/$(roomId)).data, request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    function nameMatches(room, d, uid) {
      return !('displayName' in d) || d.displayName == room.get('memberNames', {}).get(uid, '');
    }
    function msgCreateOk(room, d, me) {
      return me in room.members
        && (
          (d.get('uid', null) == me
            && d.get('text', '') is string
            && d.get('text', '').size() <= 2000   // 앱은 500자 제한, 서버 번역은 2000자까지
            && !d.keys().hasAny(['asUid', 'auto', 'kind', 'uids'])
            && d.get('type', '') != 'system'
            && nameMatches(room, d, me))
          || (!('uid' in d)
            && d.get('type', '') == 'system'
            && d.keys().hasOnly(['type', 'kind', 'uids', 'name', 'createdAt'])
            && d.uids is list && d.uids.size() >= 1 && d.uids.size() <= 50
            && room.members.hasAll(d.uids)
            && ((d.kind == 'join' && d.uids == [me] && !('name' in d))
                || (d.kind == 'added' && !(me in d.uids) && !('name' in d))
                // 방 이름 바꾸기 안내: 바꾼 사람 본인 + 방에 실제로 저장된 이름만(앱이 먼저 방 이름을 바꾼 뒤 올린다)
                || (d.kind == 'rename' && d.uids == [me] && d.get('name', null) is string
                    && d.name == room.get('name', ''))))
          || (!('uid' in d)
            && d.keys().hasOnly(['text', 'asUid', 'auto', 'displayName', 'createdAt', 'link', 'linkText'])
            && d.asUid is string
            && d.asUid != me
            && d.asUid in room.members
            && nameMatches(room, d, d.asUid)
            && autoTextOk(d.auto, d.text,
                 get(/databases/$(database)/documents/public_profiles/$(d.asUid)).data.get('store', {}))
            && autoLinkOk(d,
                 get(/databases/$(database)/documents/public_profiles/$(d.asUid)).data.get('store', {})))
        );
    }

    function autoTextOk(kind, text, st) {
      return text is string
        && ((kind == 'greeting' && st.get('greetOn', false) == true && text == string(st.get('greeting', '')).trim() && text.size() > 0)
          || (kind == 'away' && st.get('awayOn', false) == true && text == string(st.get('awayMsg', '')).trim() && text.size() > 0)
          || (kind == 'welcome' && st.get('welcomeOn', false) == true && text == string(st.get('welcome', '')).trim() && text.size() > 0));
    }
    // 첫 화면 안내 메시지의 링크 버튼 — 주인이 저장한 주소·버튼 글자와 같아야 한다. 다른 자동 메시지엔 링크 금지.
    function autoLinkOk(d, st) {
      return (!('link' in d) && !('linkText' in d))
        || (d.auto == 'welcome'
          && d.get('link', '') == st.get('welcomeUrl', '') && d.get('link', '') != ''
          && d.get('linkText', '') == st.get('welcomeBtn', ''));
    }

    // 만두 아이디 ↔ uid — 아이디 한 개 조회(get)는 로그인 전에도 허용(손님이 링크를 처음 열 때 가게를 찾기 위해).
    // 목록 조회(list)는 로그인한 사람만(내 아이디 역방향 조회용). 본인 것만 생성·수정·삭제.
    // 만들 때: 가입 회원만(익명 손님 제외), 앱과 같은 형식(영문 소문자·숫자·_ 3~20자), 정해진 칸만,
    // 운영자·공식 계정으로 오해할 수 있는 아이디(admin·mandu·official·support 등)는 선점 금지.
    // ※ 아이디는 먼저 만든 사람이 갖는 구조라 '관리자 판별'에 쓰면 안 된다 — 서버는 ADMIN_UIDS(계정 uid)만 쓴다.
    function manduidAllowed(id) {
      return id.matches('^[a-z0-9_]{3,20}$')
        && !id.matches('^(root|system|staff|team|help|helpdesk|cs|manager|operator|notice|security|service)$')
        && !id.matches('^mandu_?(team|cs|help|staff|app|kr|notice|bot|manager)?$')
        && !id.matches('.*(admin|official|support).*');
    }
    match /manduid_index/{manduid} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'
        && manduidAllowed(manduid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'searchable']);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid   // 주인(uid)은 바꿀 수 없다 (searchable 등 설정만 변경)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'searchable']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 카드북 연결 — 동의한 회원만 이메일(소문자) → {uid, manduid} 한 장을 둔다. 문서 ID가 이메일이라
    // 정확한 이메일을 알아야 한 건씩 조회(get)할 수 있고, 목록 조회는 금지. 이메일·알림 토큰·요금제 등은 들어가지 않는다.
    // 쓰기는 본인만, 그리고 문서 ID가 로그인 토큰의 (인증된) 이메일과 같아야 한다(남의 이메일로 등록 금지).
    match /cardbook_index/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email is string && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['uid', 'manduid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('manduid', '') is string && request.resource.data.get('manduid', '').size() <= 20;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 결제 정보(빌링키·customerKey·주문 기록) — 서버(Admin SDK)만 읽고 쓴다. 클라이언트는 본인 것도 접근 불가.
    match /billing_private/{uid} {
      allow read, write: if false;
    }
    match /billing_orders/{orderId} {
      allow read, write: if false;
    }

    // 공개 명함 — 다른 사람이 보는 이름·사진·만두ID·매장 설정(인사말·부재 응답·빠른 답장·직원)만.
    // 한 명 조회(get)는 누구나(손님 링크 첫 화면용), 목록 조회는 금지.
    // 쓰기는 본인만, 정해진 칸만(전화번호·이메일·알림 토큰 등은 절대 들어가지 않게).
    function publicStoreOk(st) {
      return st is map
        && st.keys().hasOnly(['active', 'greetOn', 'greeting', 'awayOn', 'awayMsg', 'quick', 'staff', 'welcomeOn', 'welcome', 'welcomeBtn', 'welcomeUrl'])
        && st.get('active', false) is bool
        && st.get('greetOn', false) is bool && st.get('awayOn', false) is bool
        && st.get('greeting', '') is string && st.get('greeting', '').size() <= 300
        && st.get('awayMsg', '') is string && st.get('awayMsg', '').size() <= 300
        && st.get('quick', []) is list && st.get('quick', []).size() <= 20
        && st.get('staff', []) is list && st.get('staff', []).size() <= 10
        // 손님 첫 화면 안내 (QR·링크로 들어온 손님이 이름을 적기 전에 보는 글 + 링크 버튼)
        && st.get('welcomeOn', false) is bool
        && st.get('welcome', '') is string && st.get('welcome', '').size() <= 300
        && st.get('welcomeBtn', '') is string && st.get('welcomeBtn', '').size() <= 30
        && st.get('welcomeUrl', '') is string && st.get('welcomeUrl', '').size() <= 300
        && (st.get('welcomeUrl', '') == '' || st.get('welcomeUrl', '').matches('https://[^ ]+'));
    }
    match /public_profiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'manduid', 'isGuest', 'store', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.manduid is string && request.resource.data.manduid.size() <= 20
        && request.resource.data.get('isGuest', false) is bool
        && (!('store' in request.resource.data) || publicStoreOk(request.resource.data.store));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 탐색(Discover) 공개 프로필 — 'Discover 공개'를 켠 사람의 공개용 정보만. 로그인한 사람은 조회·목록 가능.
    // 쓰기는 본인만, 정해진 칸만(이메일·알림 토큰 등은 들어갈 수 없게).
    match /discover_profiles/{uid} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'manduid', 'company', 'jobTitle', 'industry', 'country', 'lang', 'bio', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.manduid is string && request.resource.data.manduid.size() <= 20
        && request.resource.data.company is string && request.resource.data.company.size() <= 60
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 50
        && request.resource.data.industry is string && request.resource.data.industry.size() <= 20
        && request.resource.data.country is string && request.resource.data.country.size() <= 5
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 100;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 친구 관리 — 본인만 읽고 쓴다. (added: 직접 추가한 친구, hidden: 숨긴 친구, fav: 즐겨찾기 — 모두 {uid: 시각})
    match /friends/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 차단 목록 — 본인만 읽고 쓴다. (uids: 내가 차단한 사용자 uid 배열)
    match /blocks/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 신고 — 로그인 사용자(게스트 포함)는 본인 명의로 생성만 가능. 읽기·수정·삭제는 운영자(콘솔/Admin SDK)만.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'type', 'reason', 'roomId', 'targetUid', 'messageText', 'messageTime', 'status', 'createdAt'])
        && request.resource.data.type in ['user', 'message', 'room']
        && request.resource.data.messageText is string
        && request.resource.data.messageText.size() <= 1000;
      allow read, update, delete: if false;
    }

    // ── 만두 클래스 (대학 수업 실시간 자막, class/teacher.html · class/student.html) ──
    // 수업 코드(6자리) = 문서 id. 만든 교수님(owner)만 수업 상태·말하는 중 자막(live)·자막(segments)을 쓴다.
    // 학생(익명 로그인 포함)은 읽기만, 단 자기 언어 접속 표시(languages/{언어}.u.{내uid})만 쓸 수 있다.
    // 번역된 자막과 사용량(stats)은 서버(Admin SDK)가 기록한다. 다른 경로의 규칙은 그대로다.
    function classOwner(code) {
      return request.auth != null
        && get(/databases/$(database)/documents/classes/$(code)).data.owner == request.auth.uid;
    }
    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && code.matches('^[0-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'title', 'status', 'createdAt', 'updatedAt', 'expireAt'])
        && request.resource.data.status == 'ready'
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60
        && request.resource.data.get('ownerName', '') is string && request.resource.data.get('ownerName', '').size() <= 60;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'title', 'status', 'createdAt', 'updatedAt', 'expireAt'])
        && request.resource.data.status in ['ready', 'live', 'paused', 'ended']
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60;
      allow delete: if false;

      // 교수님이 지금 말하는 중인 한국어 (1초마다 갱신)
      match /live/{docId} {
        allow read: if request.auth != null;
        allow write: if docId == 'now' && classOwner(code)
          && request.resource.data.keys().hasOnly(['text', 't'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
      // 확정된 자막 — 보통 서버가 번역과 함께 쓰고, 서버가 안 될 때만 교수님 화면이 한국어만 쓴다
      match /segments/{segId} {
        allow read: if request.auth != null;
        allow create, update: if classOwner(code)
          && request.resource.data.keys().hasOnly(['ko', 'tr', 't', 'engine', 'at', 'err'])
          && request.resource.data.ko is string && request.resource.data.ko.size() <= 1000;
        allow delete: if false;
      }
      // 접속 언어 — 문서 id = 언어 코드, u = {학생uid: 마지막 신호 시각}. 자기 uid 칸만 넣고 뺄 수 있다.
      match /languages/{lang} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && lang in ['en', 'ja', 'zh', 'es', 'fr', 'de', 'vi', 'th', 'mn', 'hi', 'pt', 'ar', 'id', 'it', 'da']
          && request.resource.data.keys().hasOnly(['u'])
          && request.resource.data.u.keys().hasOnly([request.auth.uid]);
        allow update: if request.auth != null
          && request.resource.data.keys().hasOnly(['u'])
          && request.resource.data.u.diff(resource.data.get('u', {})).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if false;
      }
      // 사용량(번역 글자·AI 토큰) — 서버만 기록, 교수님만 읽는다
      match /stats/{docId} {
        allow read: if classOwner(code);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
