rules_version = '2';
// MANDU 전용 Firebase 프로젝트(mandutok) 규칙.
// 콘솔에서 직접 고치지 말고 이 파일을 고친 뒤 전체를 복사해 게시할 것.
service cloud.firestore {
  match /databases/{database}/documents {

    // 게스트(익명 로그인 — 가게 링크·QR이나 그룹 초대 링크로 회원 가입 없이 들어온 사람)인가.
    // 게스트는 들어온 대화방에서 대화만 할 수 있다. 방 만들기(자기 손님방 빼고)·멤버 추가·만두 ID·탐색·친구·내 사전·매장 설정은 가입 후에만.
    function isAnon() {
      return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // 사용자 프로필(이메일·알림 토큰·요금제·사용량 포함) — 본인만 읽는다.
    // 다른 사람에게 필요한 이름·사진·만두ID·매장 설정은 public_profiles 에서 읽는다(아래).
    // 전체 가입자 목록 조회(list)는 금지(동의 여부와 상관없이). 카드북 연결은 users가 아니라 cardbook_index(만두 ID만)를 읽는다(아래).
    // 탐색 탭은 users가 아니라 discover_profiles(공개용 정보만)를 읽는다. 쓰기는 본인만. 단 번역 사용량(usage)·요금제(plan)·결제 요약(billing)은 서버(Admin SDK, 규칙 우회)만
    // 기록한다 — 결제 성공 시에만 서버가 plan/billing을 쓰므로 클라이언트는 만들거나 바꿀 수 없다.
    // 사장님 한도 임박 안내(quotaAlert)도 서버만 기록한다(보낼 때 번역 — mandu-server server/send_translate.py).
    // 추천 보너스(bonusChars·bonusExpiresAt·bonusUsed)와 충전 글자(packChars·packExpiresAt·packUsed)도 서버만 기록한다. 추천 기록(referrals)은 맨 아래 기본 차단 규칙으로 서버 전용.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['usage', 'plan', 'billing', 'bonusChars', 'bonusExpiresAt', 'bonusUsed', 'packChars', 'packExpiresAt', 'packUsed', 'quotaAlert']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usage', 'plan', 'billing', 'bonusChars', 'bonusExpiresAt', 'bonusUsed', 'packChars', 'packExpiresAt', 'packUsed', 'quotaAlert']);
      allow delete: if request.auth != null && request.auth.uid == uid;   // 회원 탈퇴 시 본인 프로필 삭제

      // 번역 사용 내역 — 서버(Admin SDK)만 기록하고, 본인만 읽는다. (원문은 저장되지 않음)
      match /usage_log/{logId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // 내 사전 — 본인만 읽고 쓴다.
      match /mydict/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && !isAnon();
      }

      // 번역 결과 백업 — 한 번 번역한 메시지를 다른 기기·앱 재설치 후에도 같은 번역으로 보여준다. 본인만 읽고 쓴다.
      match /trcache/{key} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 매장(손님) 방 표시 — storeUid·customerUid·isGuestRoom 은 방 ID와 맞아야 한다.
    //   손님 방 ID = guest_{손님uid}_{주인uid} (익명 손님) / store_{손님uid}_{주인uid} (가입한 손님)
    //   → 남의 방을 '내 가게 손님방'으로 꾸며 주인 번역 한도를 쓰게 만드는 위조를 막는다.
    function storeFieldsOk(roomId, d) {
      return !(d.get('storeUid', null) != null || d.get('customerUid', null) != null || d.get('isGuestRoom', false) == true)
        || (d.storeUid is string && d.customerUid is string
            && d.storeUid in d.members && d.customerUid in d.members
            && ((roomId == 'store_' + d.customerUid + '_' + d.storeUid && d.get('isGuestRoom', false) == false)
                || roomId == 'guest_' + d.customerUid + '_' + d.storeUid));
    }

    // 1:1 방 ID(uidA_uidB, 정렬)는 그 두 사람만으로 만들 수 있다 — 남이 먼저 만들어 끼어들거나 두 사람의 1:1 방을 막는 것 방지.
    // (나중에 멤버를 추가해 그룹이 되는 것은 update 규칙이 허용한다)
    function directIdOk(roomId, d) {
      return !roomId.matches('^[A-Za-z0-9]+_[A-Za-z0-9]+$') || roomId.matches('^(guest|store|tester)_.*')
        || (d.members.size() == 2 && roomId == d.members[0] + '_' + d.members[1]);
    }
    // 게스트는 방을 만들 수 없다. 단 가게 링크로 들어오면 그 가게와의 손님방(guest_{내uid}_{주인uid}) 하나만 열린다(가게와 대화하려면 필요).
    // 익명 계정은 얼마든지 새로 만들 수 있어서, 아무 회원이나 넣은 방을 만들어 스팸·푸시를 보내는 것을 막는다.
    // 방 안에서도 게스트는 대화에 필요한 칸(마지막 메시지·안 읽음 수·읽음 표시)만 바꿀 수 있다 — 멤버 추가·방 이름 변경 금지.
    // (그룹 초대 링크로 들어오는 것은 서버가 /api/rooms/join 으로 넣어 준다)
    function anonUpdateOk(roomId) {
      return !isAnon() || roomId.matches('^guest_' + request.auth.uid + '_[A-Za-z0-9]+$')
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageUid', 'unreadCount', 'readBy', 'memberLangs']);
    }
    function anonRoomOk(roomId) {
      return !isAnon() || roomId.matches('^guest_' + request.auth.uid + '_[A-Za-z0-9]+$');
    }

    // 방에 적힌 이름·사진(memberNames·memberPhotos) — 남의 칸은 바꿀 수 없다(방 안에서 남을 사칭하는 것 방지).
    //  - 내 칸: 자유롭게 / 새로 들어온 멤버의 칸: 추가 가능(멤버 추가) / 방을 나간 사람의 칸: 지우기 가능
    //  - 매장 방에서 손님·주인은 직원 구성을 맞추느라 직원·주인 칸을 다시 적을 수 있다
    function memberMapOk(field) {
      let d = request.resource.data.get(field, {}).diff(resource.data.get(field, {}));
      return d.changedKeys().hasOnly([request.auth.uid])
        && d.addedKeys().hasOnly(request.resource.data.members.concat([request.auth.uid]))
        && d.removedKeys().intersection(request.resource.data.members.toSet().difference([request.auth.uid].toSet())).size() == 0;
    }
    // 보낼 때 번역: 방 멤버의 언어(memberLangs) — 내 칸만 적는다. 서버가 보내는 순간 이 값으로 번역할 언어를 정한다.
    function memberLangsOk() {
      return request.resource.data.get('memberLangs', {}).diff(resource.data.get('memberLangs', {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }
    // 들어온 시각(joinedAt) — 이번에 새로 추가되는 멤버의 칸만 적을 수 있다(그 사람에게는 이 뒤 메시지만 보인다).
    // 초대 링크로 들어오는 것은 서버가 적는다(/api/rooms/join).
    function joinedAtOk() {
      return request.resource.data.get('joinedAt', {}).diff(resource.data.get('joinedAt', {})).affectedKeys()
        .hasOnly(request.resource.data.members.removeAll(resource.data.members));
    }
    // 방 종류(roomType): 없으면 일반 방, 'lecture' = 강의 방(번역 글자는 방장 ownerUid 가 낸다).
    // 만들 때만 정하고 바꿀 수 없다. 방장은 만든 사람 본인. schoolId 는 나중에 학교 요금제를 붙일 자리 — 지금은 비워 둔다(서버만 나중에 기록).
    function roomTypeCreateOk(d) {
      return (!('roomType' in d) && !('ownerUid' in d) && d.get('schoolId', null) == null)
        || (d.roomType == 'lecture' && d.get('type', '') == 'group' && d.get('ownerUid', '') == request.auth.uid
            && d.get('schoolId', null) == null);
    }
    function roomTypeSame() {
      return request.resource.data.get('roomType', null) == resource.data.get('roomType', null)
        && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
        && request.resource.data.get('schoolId', null) == resource.data.get('schoolId', null);
    }
    function storeStaffEditor() {
      return resource.data.get('storeUid', null) != null
        && request.auth.uid in [resource.data.storeUid, resource.data.get('customerUid', '')];
    }
    // 안 읽음 수(unreadCount) — 내 숫자만(읽으면 0). 받는 사람들의 숫자는 서버가 메시지 알림을 보낼 때 올린다.
    function unreadOk() {
      return request.resource.data.get('unreadCount', {}).diff(resource.data.get('unreadCount', {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    // 채팅방 — 멤버만 읽고 쓸 수 있다.
    match /rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // 만들 때: 내가 멤버에 포함, 최대 100명(서버 rooms.py ROOM_MAX_MEMBERS 와 같게), 매장 방이면 내가 그 손님 본인이어야 한다.
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 100
        && storeFieldsOk(roomId, request.resource.data)
        && (!roomId.matches('^(guest|store)_.*') || request.resource.data.get('storeUid', null) != null)   // 손님방 ID면 매장 정보 필수
        && request.resource.data.get('customerUid', request.auth.uid) == request.auth.uid
        && directIdOk(roomId, request.resource.data)
        && roomTypeCreateOk(request.resource.data)
        && !('joinedAt' in request.resource.data)
        && request.resource.data.get('memberLangs', {}).keys().hasOnly([request.auth.uid])
        && anonRoomOk(roomId);
      // 고칠 때: 멤버만. 다른 멤버를 내보낼 수 없고(추가·본인 나가기만), 매장 방 정보는 바꿀 수 없으며,
      // 읽음 표시(readBy)는 본인 것만 바꿀 수 있다.
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 100
        && (request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
            // 매장 방: 손님·주인은 직원 구성을 맞출 수 있다(직원 변경·1:1로 되돌리기). 손님과 주인은 항상 남아 있어야 한다.
            || (resource.data.get('storeUid', null) != null
                && request.auth.uid in [resource.data.storeUid, resource.data.get('customerUid', '')]
                && request.resource.data.members.hasAll([resource.data.storeUid, resource.data.get('customerUid', '')])))
        && storeFieldsOk(roomId, request.resource.data)
        && (!('storeUid' in resource.data) || request.resource.data.get('storeUid', null) == resource.data.storeUid)
        && (!('customerUid' in resource.data) || request.resource.data.get('customerUid', null) == resource.data.customerUid)
        && (!('isGuestRoom' in resource.data) || request.resource.data.get('isGuestRoom', null) == resource.data.isGuestRoom)
        && (!('readBy' in request.resource.data)
            || request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid]))
        && (storeStaffEditor() || (memberMapOk('memberNames') && memberMapOk('memberPhotos')))
        && unreadOk()
        && memberLangsOk()
        && joinedAtOk()
        && roomTypeSame()
        && anonUpdateOk(roomId);
      allow delete: if false;

      // 메시지 — 그 방 멤버만. 세 종류만 허용:
      //  1) 일반 메시지: 보낸 사람(uid)이 본인
      //  2) 시스템 안내(입장·멤버 추가): type 'system', 짧은 글만
      //  3) 매장 자동 메시지(인사말·부재 응답): 손님 기기가 주인 이름으로 올리므로,
      //     글 내용이 주인이 공개 프로필에 저장한 인사말/부재 응답과 정확히 같아야 한다(가짜 공지 방지).
      //  모든 메시지: 보낸 시각(createdAt)은 서버 시각이어야 한다(과거·미래 시각으로 대화 순서를 조작하는 것 방지),
      //  사진·파일 주소는 만두 업로드 저장소(Cloudinary)만 — 남의 서버 주소를 넣어 읽는 사람의 IP를 모으는 것 방지.
      //  읽기: 방에 들어온 시각(joinedAt.{내uid})이 있으면 그 뒤 메시지만 (새 멤버에게 지난 대화는 보이지 않는다).
      //  보낼 때 번역 결과(translations 등)는 서버만 적는다 — 앱이 만들 때 미리 넣을 수 없다.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
          && (!(request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.get('joinedAt', {}))
              || resource.data.createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)).data.joinedAt[request.auth.uid]);
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
          && request.resource.data.get('createdAt', null) == request.time
          && uploadUrlOk(request.resource.data.get('imageUrl', ''))
          && uploadUrlOk(request.resource.data.get('fileUrl', ''))
          && !request.resource.data.keys().hasAny(['translations', 'trEngine', 'trDone', 'trCharged', 'trClaimAt', 'untranslated', 'trReason', 'trPaidBy', 'trLangs'])
          && request.resource.data.get('trMode', 'send') == 'send'
          && (
            (request.resource.data.get('uid', null) == request.auth.uid
              && request.resource.data.get('text', '') is string
              && request.resource.data.get('text', '').size() <= 2000   // 앱은 500자 제한, 서버 번역은 2000자까지
              && !request.resource.data.keys().hasAny(['asUid', 'auto'])
              && request.resource.data.get('type', '') != 'system')
            || (!('uid' in request.resource.data)
              && request.resource.data.get('type', '') == 'system'
              && request.resource.data.keys().hasOnly(['type', 'text', 'createdAt'])
              && request.resource.data.text is string && request.resource.data.text.size() <= 300)
            || (!('uid' in request.resource.data)
              && request.resource.data.keys().hasOnly(['text', 'asUid', 'auto', 'displayName', 'createdAt', 'link', 'linkText'])
              && request.resource.data.asUid is string
              && request.resource.data.asUid != request.auth.uid
              && request.resource.data.asUid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
              && autoTextOk(request.resource.data.auto, request.resource.data.text,
                   get(/databases/$(database)/documents/public_profiles/$(request.resource.data.asUid)).data.get('store', {}))
              && autoLinkOk(request.resource.data,
                   get(/databases/$(database)/documents/public_profiles/$(request.resource.data.asUid)).data.get('store', {})))
          );
        allow update, delete: if false;
      }
    }

    function uploadUrlOk(u) {
      return u is string && (u == '' || u.matches('^https://res[.]cloudinary[.]com/dei44zkfy/[^ ]+$'));
    }
    function autoTextOk(kind, text, st) {
      return text is string
        && ((kind == 'greeting' && st.get('greetOn', false) == true && text == string(st.get('greeting', '')).trim() && text.size() > 0)
          || (kind == 'away' && st.get('awayOn', false) == true && text == string(st.get('awayMsg', '')).trim() && text.size() > 0)
          || (kind == 'welcome' && st.get('welcomeOn', false) == true && text == string(st.get('welcome', '')).trim() && text.size() > 0));
    }
    // 첫 화면 안내 메시지의 링크 버튼 — 주인이 저장한 주소·버튼 글자와 같아야 한다. 다른 자동 메시지엔 링크 금지.
    function autoLinkOk(d, st) {
      return (!('link' in d) && !('linkText' in d))
        || (d.auto == 'welcome'
          && d.get('link', '') == st.get('welcomeUrl', '') && d.get('link', '') != ''
          && d.get('linkText', '') == st.get('welcomeBtn', ''));
    }

    // 만두 아이디 ↔ uid — 아이디 한 개 조회(get)는 로그인 전에도 허용(손님이 링크를 처음 열 때 가게를 찾기 위해).
    // 목록 조회(list)는 내 uid로 찾는 역방향 조회만(where uid == 내 uid). 전체 회원 ID·uid 명단은 받아 갈 수 없다. 본인 것만 생성·수정·삭제.
    match /manduid_index/{manduid} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && !isAnon() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && !isAnon() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;   // 주인(uid)은 바꿀 수 없다 (searchable 등 설정만 변경)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 카드북 연결 — '카드북에서 나를 찾아도 좋아요'를 켠 회원만 문서가 있다. 문서 id = 소문자 이메일, 내용은 uid·만두 ID뿐.
    // 이메일을 정확히 아는 사람만 한 건씩 조회(get)할 수 있고, 목록 조회(list)는 금지 → 동의자 명단을 통째로 받아 갈 수 없다.
    // 쓰기는 로그인 계정의 인증된 이메일과 문서 id가 같을 때만, 만두 ID는 manduid_index 상 본인 것이어야 한다(남의 이메일·남의 ID로 등록 방지).
    match /cardbook_index/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email', '').lower() == email
        && request.auth.token.get('email_verified', false) == true   // 인증된 이메일만(남의 이메일로 가입해 등록하는 것 방지)
        && request.resource.data.keys().hasOnly(['uid', 'manduid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.manduid is string
        && request.resource.data.manduid.size() > 0 && request.resource.data.manduid.size() <= 20
        && get(/databases/$(database)/documents/manduid_index/$(request.resource.data.manduid)).data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || (request.auth.token.get('email', '') is string && request.auth.token.get('email', '').lower() == email));
    }

    // 결제 정보(빌링키·customerKey·주문 기록) — 서버(Admin SDK)만 읽고 쓴다. 클라이언트는 본인 것도 접근 불가.
    match /billing_private/{uid} {
      allow read, write: if false;
    }
    match /billing_orders/{orderId} {
      allow read, write: if false;
    }

    // 공개 명함 — 다른 사람이 보는 이름·사진·만두ID·매장 설정(인사말·부재 응답·빠른 답장·직원)만.
    // 한 명 조회(get)는 누구나(손님 링크 첫 화면용), 목록 조회는 금지.
    // 쓰기는 본인만, 정해진 칸만(전화번호·이메일·알림 토큰 등은 절대 들어가지 않게).
    function publicStoreOk(st) {
      return st is map
        && st.keys().hasOnly(['greetOn', 'greeting', 'awayOn', 'awayMsg', 'quick', 'staff', 'welcomeOn', 'welcome', 'welcomeBtn', 'welcomeUrl'])
        && st.get('greetOn', false) is bool && st.get('awayOn', false) is bool
        && st.get('greeting', '') is string && st.get('greeting', '').size() <= 300
        && st.get('awayMsg', '') is string && st.get('awayMsg', '').size() <= 300
        && st.get('quick', []) is list && st.get('quick', []).size() <= 20
        && st.get('staff', []) is list && st.get('staff', []).size() <= 10
        // 손님 첫 화면 안내 (QR·링크로 들어온 손님이 이름을 적기 전에 보는 글 + 링크 버튼)
        && st.get('welcomeOn', false) is bool
        && st.get('welcome', '') is string && st.get('welcome', '').size() <= 300
        && st.get('welcomeBtn', '') is string && st.get('welcomeBtn', '').size() <= 30
        && st.get('welcomeUrl', '') is string && st.get('welcomeUrl', '').size() <= 300
        && (st.get('welcomeUrl', '') == '' || st.get('welcomeUrl', '').matches('https://[^ ]+'));
    }
    function storeAllOff(st) {
      return st.get('greetOn', false) == false && st.get('awayOn', false) == false
        && st.get('welcomeOn', false) == false && st.get('staff', []).size() == 0;
    }
    match /public_profiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'manduid', 'isGuest', 'store', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.manduid is string && request.resource.data.manduid.size() <= 20
        && request.resource.data.get('isGuest', false) is bool
        && (!('store' in request.resource.data) || (publicStoreOk(request.resource.data.store)
            && (!isAnon() || storeAllOff(request.resource.data.store))));   // 게스트는 매장 기능을 켤 수 없다(앱은 기본값=모두 꺼짐을 보냄)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 탐색(Discover) 공개 프로필 — 'Discover 공개'를 켠 사람의 공개용 정보만. 로그인한 사람은 조회·목록 가능.
    // 쓰기는 본인만, 정해진 칸만(이메일·알림 토큰 등은 들어갈 수 없게).
    match /discover_profiles/{uid} {
      allow get, list: if request.auth != null && !isAnon();
      allow create, update: if request.auth != null && !isAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'manduid', 'company', 'jobTitle', 'industry', 'country', 'lang', 'bio', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500
        && request.resource.data.manduid is string && request.resource.data.manduid.size() <= 20
        && request.resource.data.company is string && request.resource.data.company.size() <= 60
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 50
        && request.resource.data.industry is string && request.resource.data.industry.size() <= 20
        && request.resource.data.country is string && request.resource.data.country.size() <= 5
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 100;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 친구 관리 — 본인만 읽고 쓴다. (added: 직접 추가한 친구, hidden: 숨긴 친구, fav: 즐겨찾기 — 모두 {uid: 시각})
    match /friends/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && !isAnon();
    }

    // 차단 목록 — 본인만 읽고 쓴다. (uids: 내가 차단한 사용자 uid 배열)
    match /blocks/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 신고 — 로그인 사용자(게스트 포함)는 본인 명의로 생성만 가능. 읽기·수정·삭제는 운영자(콘솔/Admin SDK)만.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'type', 'reason', 'roomId', 'targetUid', 'messageText', 'messageTime', 'status', 'createdAt'])
        && request.resource.data.type in ['user', 'message', 'room']
        && request.resource.data.messageText is string
        && request.resource.data.messageText.size() <= 1000;
      allow read, update, delete: if false;
    }

    // ── 만두 클래스 (대학 수업 실시간 자막, class/teacher.html · class/student.html) ──
    // 수업 코드(6자리) = 문서 id. 만든 교수님(owner)만 수업 상태·말하는 중 자막(live)·자막(segments)을 쓴다.
    // 학생(익명 로그인 포함)은 읽기만, 단 자기 언어 접속 표시(languages/{언어}.u.{내uid})만 쓸 수 있다.
    // 번역된 자막과 사용량(stats)은 서버(Admin SDK)가 기록한다. 다른 경로의 규칙은 그대로다.
    function classOwner(code) {
      return request.auth != null
        && get(/databases/$(database)/documents/classes/$(code)).data.owner == request.auth.uid;
    }
    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && code.matches('^[0-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'title', 'status', 'createdAt', 'updatedAt', 'expireAt'])
        && request.resource.data.status == 'ready'
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60
        && request.resource.data.get('ownerName', '') is string && request.resource.data.get('ownerName', '').size() <= 60;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'title', 'status', 'createdAt', 'updatedAt', 'expireAt'])
        && request.resource.data.status in ['ready', 'live', 'paused', 'ended']
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60;
      allow delete: if false;

      // 교수님이 지금 말하는 중인 한국어 (1초마다 갱신)
      match /live/{docId} {
        allow read: if request.auth != null;
        allow write: if docId == 'now' && classOwner(code)
          && request.resource.data.keys().hasOnly(['text', 't'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
      // 확정된 자막 — 보통 서버가 번역과 함께 쓰고, 서버가 안 될 때만 교수님 화면이 한국어만 쓴다
      match /segments/{segId} {
        allow read: if request.auth != null;
        allow create, update: if classOwner(code)
          && request.resource.data.keys().hasOnly(['ko', 'tr', 't', 'engine', 'at', 'err'])
          && request.resource.data.ko is string && request.resource.data.ko.size() <= 1000;
        allow delete: if false;
      }
      // 접속 언어 — 문서 id = 언어 코드, u = {학생uid: 마지막 신호 시각}. 자기 uid 칸만 넣고 뺄 수 있다.
      match /languages/{lang} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && lang in ['en', 'ja', 'zh', 'es', 'fr', 'de', 'vi', 'th', 'mn', 'hi', 'pt', 'ar', 'id', 'it', 'da', 'ru']
          && request.resource.data.keys().hasOnly(['u'])
          && request.resource.data.u.keys().hasOnly([request.auth.uid]);
        allow update: if request.auth != null
          && request.resource.data.keys().hasOnly(['u'])
          && request.resource.data.u.diff(resource.data.get('u', {})).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if false;
      }
      // 사용량(번역 글자·AI 토큰) — 서버만 기록, 교수님만 읽는다
      match /stats/{docId} {
        allow read: if classOwner(code);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
