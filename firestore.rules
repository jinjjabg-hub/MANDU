rules_version = '2';
// MANDU 전용 Firebase 프로젝트(mandutok) 규칙.
// 콘솔에서 직접 고치지 말고 이 파일을 고친 뒤 전체를 복사해 게시할 것.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필 — 친구 목록·게스트 연결 때문에 로그인(익명 게스트 포함)한 사람은 누구나 읽을 수 있다.
    // 쓰기는 본인만. 번역 사용량(usage)은 서버(Admin SDK, 규칙 우회)만 기록하므로 클라이언트는 못 바꾼다.
    // ⚠️ plan은 베타 기간이라 요금제 시트에서 본인이 직접 바꾸는 구조 — 실결제 붙일 때 usage처럼 잠글 것.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['usage']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usage']);
      allow delete: if request.auth != null && request.auth.uid == uid;   // 회원 탈퇴 시 본인 프로필 삭제

      // 내 사전 — 본인만 읽고 쓴다.
      match /mydict/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 채팅방 — 멤버만 읽고 쓸 수 있다. 생성 시 만든 사람이 멤버 목록에 포함돼야 한다.
    match /rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;

      // 메시지 — 그 방 멤버만. 보낸 사람(uid)은 본인이어야 한다(시스템 메시지는 uid가 없어서 통과).
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
          && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 만두 아이디 ↔ uid — 로그인한 사람은 누구나 조회(게스트 링크 연결용), 본인 것만 생성·수정·삭제.
    match /manduid_index/{manduid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
